from contextlib import AbstractContextManager
from dataclasses import dataclass
from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple, Type, Union

from transitions import EventData
from transitions.core import Machine, ModelParameter, StateIdentifier, TransitionConfig


class PublishingError(Exception): ...
class CommandConflict(PublishingError): ...
class PendingCommandError(PublishingError):
    pending_command_id: str
    confirmed_version: int
    def __init__(self, pending_command_id: str, confirmed_version: int) -> None: ...

class NoAcceptedCandidate(PublishingError): ...
class StaleReceiptError(PublishingError): ...
class VersionConflict(PublishingError): ...
class ReceiptMismatch(PublishingError): ...
class ResponseLost(PublishingError):
    response: Optional[Any]
    def __init__(self, message: str = ..., response: Optional[Any] = ...) -> None: ...

class ResponseNotReady(PublishingError): ...

@dataclass(frozen=True)
class Manifest:
    partition: str
    version: int
    command_id: str
    candidates: Tuple[Any, ...]
    payload: Any
    metadata: Any
    digest: str
    @classmethod
    def create(cls, partition: str, version: int, command_id: str,
               candidates: Optional[Sequence[Any]] = ..., payload: Any = ...,
               metadata: Any = ...) -> Manifest: ...
    def as_dict(self) -> Dict[str, Any]: ...
    to_dict = as_dict
    @classmethod
    def from_dict(cls, value: Dict[str, Any]) -> Manifest: ...

@dataclass(frozen=True)
class Receipt:
    partition: str
    version: int
    command_id: Any
    manifest_digest: str
    previous_digest: Optional[str]
    token: str
    @classmethod
    def create(cls, manifest: Manifest, previous_receipt: Optional[Receipt] = ...) -> Receipt: ...
    def as_dict(self) -> Dict[str, Any]: ...
    to_dict = as_dict
    @classmethod
    def from_dict(cls, value: Dict[str, Any]) -> Receipt: ...

@dataclass(frozen=True)
class StoredCommand:
    partition: str
    command_id: str
    request_digest: str
    state: str
    manifest: Manifest
    predecessor: Optional[Receipt]
    receipt: Optional[Receipt]
    trial: Tuple[Dict[str, Any], ...]
    @property
    def pending(self) -> bool: ...

@dataclass(frozen=True)
class CommandResult:
    command_id: str
    partition: str
    manifest: Optional[Manifest]
    receipt: Optional[Receipt] = ...
    confirmed_version: Optional[int] = ...
    pending: bool = ...
    response: Any = ...
    @property
    def version(self) -> Optional[int]: ...
    @property
    def status(self) -> str: ...

class DeferredResponse:
    command_id: Optional[str]
    partition: Optional[str]
    def __init__(self, command_id: Optional[str] = ..., partition: Optional[str] = ...) -> None: ...
    def hold(self, receipt: Receipt) -> DeferredResponse: ...
    def resolve(self, receipt: Optional[Receipt] = ...) -> DeferredResponse: ...
    release = resolve
    @property
    def ready(self) -> bool: ...
    @property
    def held_receipt(self) -> Optional[Receipt]: ...
    def wait(self) -> Receipt: ...

class Warehouse:
    def __init__(self) -> None: ...
    def seed(self, partition: str, version: int, command_id: Optional[str] = ...,
             candidates: Optional[Sequence[Any]] = ..., payload: Any = ...) -> Receipt: ...
    bootstrap = seed
    def current_receipt(self, partition: str) -> Optional[Receipt]: ...
    def manifest_for(self, partition: str, version: int) -> Optional[Manifest]: ...
    def manifests(self, partition: str) -> List[Manifest]: ...
    def receipt_for_command(self, partition: str, command_id: str) -> Optional[Receipt]: ...
    def receive(self, manifest: Manifest,
                previous_receipt: Optional[Receipt] = ...) -> Receipt: ...
    publish = receive

class DeferredWarehouse(Warehouse):
    defer_first: bool
    deferred_responses: List[DeferredResponse]
    def __init__(self, defer_first: bool = ...) -> None: ...
    @property
    def first_response(self) -> Optional[DeferredResponse]: ...
    def release_first_response(self, receipt: Optional[Receipt] = ...) -> DeferredResponse: ...
    release = release_first_response

class SQLiteCommandStore:
    path: str
    def __init__(self, path: str = ..., connection: Any = ...) -> None: ...
    def close(self) -> None: ...
    def get_confirmation(self, partition: str) -> Optional[Receipt]: ...
    def confirmed_version(self, partition: str) -> Optional[int]: ...
    def seed_confirmation(self, partition: str, receipt: Receipt) -> Receipt: ...
    def set_confirmation(self, partition: str, receipt: Receipt) -> Receipt: ...
    def save_prepared(self, partition: str, command_id: str, request_digest: str,
                      manifest: Manifest, predecessor: Optional[Receipt] = ...,
                      trial: Optional[Sequence[Dict[str, Any]]] = ...) -> None: ...
    def load_trials(self, partition: str, command_id: str) -> Tuple[Dict[str, Any], ...]: ...
    def load_command(self, partition: str, command_id: str) -> Optional[StoredCommand]: ...
    def pending_commands(self, partition: str) -> List[StoredCommand]: ...
    def mark_sent(self, partition: str, command_id: str) -> None: ...
    def mark_confirmed(self, partition: str, command_id: str, receipt: Receipt) -> None: ...
    def mark_failed(self, partition: str, command_id: str) -> None: ...
    def delete_command(self, partition: str, command_id: str) -> None: ...

class PublishingMachine(Machine):
    warehouse: Warehouse
    command_store: SQLiteCommandStore
    publish_trigger: str
    clean: Any
    trial: Any
    partition: Optional[str]
    def __init__(self, model: Optional[ModelParameter] = ...,
                 states: Optional[Any] = ..., initial: Optional[StateIdentifier] = ...,
                 transitions: Optional[Union[TransitionConfig, Sequence[TransitionConfig]]] = ...,
                 send_event: bool = ..., auto_transitions: bool = ..., ordered_transitions: bool = ...,
                 ignore_invalid_triggers: Optional[bool] = ...,
                 before_state_change: Any = ..., after_state_change: Any = ..., name: str = ...,
                 queued: bool = ..., prepare_event: Any = ..., finalize_event: Any = ...,
                 model_attribute: str = ..., model_override: bool = ..., on_exception: Any = ...,
                 on_final: Any = ..., warehouse: Optional[Warehouse] = ...,
                 command_store: Optional[SQLiteCommandStore] = ..., db_path: Optional[str] = ...,
                 publish_trigger: str = ..., clean: Any = ..., trial: Any = ...,
                 partition: Optional[str] = ..., **kwargs: Any) -> None: ...
    def prepare_command(self, command_id: str, partition: Optional[str] = ...,
                        version: Optional[int] = ..., candidates: Optional[Sequence[Any]] = ...,
                        inputs: Optional[Sequence[Any]] = ..., payload: Any = ...,
                        manifest: Optional[Manifest] = ..., model: Any = ...,
                        **options: Any) -> StoredCommand: ...
    def publish_command(self, command_id: str, partition: Optional[str] = ...,
                        version: Optional[int] = ..., candidates: Optional[Sequence[Any]] = ...,
                        inputs: Optional[Sequence[Any]] = ..., payload: Any = ...,
                        manifest: Optional[Manifest] = ..., model: Any = ...,
                        **options: Any) -> CommandResult: ...
    run_command = publish_command
    def resume_command(self, command_id: str, partition: Optional[str] = ...,
                       model: Any = ..., **options: Any) -> CommandResult: ...
    resume = resume_command
    def deliver(self, response: Any, receipt: Optional[Receipt] = ...,
                model: Any = ...) -> CommandResult: ...
    def release_response(self, response: Any = ..., partition: Optional[str] = ...,
                         command_id: Optional[str] = ...,
                         receipt: Optional[Receipt] = ...) -> CommandResult: ...
    def get_confirmation(self, partition: Optional[str] = ...) -> Optional[Receipt]: ...
    def get_confirmed_version(self, partition: Optional[str] = ...) -> Optional[int]: ...
    def get_pending_command_id(self, partition: Optional[str] = ...) -> Optional[str]: ...
    @property
    def confirmed_version(self) -> Optional[int]: ...
    @property
    def pending_command_id(self) -> Optional[str]: ...
    def seed(self, version: int, partition: Optional[str] = ...,
             candidates: Optional[Sequence[Any]] = ..., payload: Any = ...) -> Receipt: ...
    bootstrap = seed

Publication = Manifest
Acknowledgement = Receipt
WarehouseReceipt = Receipt
CommandJournal = SQLiteCommandStore
CommandStore = SQLiteCommandStore
PublishMachine = PublishingMachine
PublicationMachine = PublishingMachine
RecoverablePublishingMachine = PublishingMachine
CommandIdConflict = CommandConflict
CommandPending = PendingCommandError
PublicationResult = CommandResult
