# entry_left1.lark — entry paired with headers_left1.lark (proposed: left wins).
%import headers_left1.left
%import headers_left1.right

batch: "sync" "delta" left ";" lt
     | "sync" "delta" right ";" rt

checkpoint: "resume" "delta" left ";" rt
          | "resume" "delta" right ";" lt

lt: LOW | HIGH "?"
rt: LOW ["?"]

HIGH.2: /[a-z]+/
LOW: /[a-z]+/

%ignore /\s+/
